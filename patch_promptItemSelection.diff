// Generic Option Selection Popup Modal
=======
window.promptItemSellSelection = function(playerNum, titleText, callback) {
    const inv = playerNum === 2 ? window.p2Inventory : window.p1Inventory;
    const activeItems = inv.filter(item => item.quantity > 0);

    if (activeItems.length === 0) {
        window.showModernNotification("❌ You have no items in your inventory!");
        return;
    }

    const prevActiveModal = playerNum === 2 ? window.p2ActiveModal : window.p1ActiveModal;
    const modalId = playerNum === 2 ? 'itemSellSelectModal_p2' : 'itemSellSelectModal_p1';

    const overlay = document.createElement('div');
    overlay.id = modalId;
    overlay.style.position = 'fixed';
    overlay.style.top = '0';
    if (window.coopActive) {
        overlay.style.width = '50vw';
        if (playerNum === 2) {
            overlay.style.left = '50vw';
        } else {
            overlay.style.left = '0';
        }
    } else {
        overlay.style.width = '100vw';
        overlay.style.left = '0';
    }
    overlay.style.height = '100vh';
    overlay.style.background = 'rgba(0,0,0,0.7)';
    overlay.style.zIndex = '300000';
    overlay.style.display = 'flex';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';

    if (playerNum === 2) {
        window.p2ActiveModal = modalId;
    } else {
        window.p1ActiveModal = modalId;
    }
    if (window.updateModalVisibility) {
        window.updateModalVisibility();
    }

    const dialog = document.createElement('div');
    dialog.style.background = 'linear-gradient(135deg, #112a1a, #071510)';
    dialog.style.border = '2px solid #a5d6a7';
    dialog.style.borderRadius = '12px';
    dialog.style.padding = '20px';
    dialog.style.width = '320px';
    dialog.style.maxWidth = '90%';
    dialog.style.color = 'white';
    dialog.style.textAlign = 'center';
    dialog.style.boxShadow = '0 8px 24px rgba(0,0,0,0.6)';

    const title = document.createElement('h3');
    title.innerText = titleText;
    title.style.margin = '0 0 15px 0';
    title.style.color = '#a5d6a7';
    dialog.appendChild(title);

    const allStoreItems = window.getAllStoreItems ? window.getAllStoreItems() : [];

    activeItems.forEach((item, index) => {
        let storeItemInfo = allStoreItems.find(s => s.name === item.name);
        let basePrice = storeItemInfo ? storeItemInfo.price : 0;
        let sellPrice = Math.floor(basePrice * 0.6);

        const btn = document.createElement('button');
        btn.className = 'item-sell-select-btn';
        btn.style.display = 'flex';
        btn.style.alignItems = 'center';
        btn.style.justifyContent = 'space-between';
        btn.style.width = '100%';
        btn.style.margin = '10px 0';
        btn.style.padding = '10px';
        btn.style.background = 'rgba(255,255,255,0.1)';
        btn.style.border = '1px solid rgba(255,255,255,0.2)';
        btn.style.borderRadius = '8px';
        btn.style.color = 'white';
        btn.style.cursor = 'pointer';
        btn.style.textAlign = 'left';
        btn.style.fontSize = '13px';
        btn.style.transition = 'background 0.2s';

        btn.onmouseover = () => { btn.style.background = 'rgba(255,255,255,0.2)'; };
        btn.onmouseout = () => { btn.style.background = 'rgba(255,255,255,0.1)'; };

        btn.innerHTML = `
            <div>
                <div style="font-weight: bold;">${item.name}</div>
                <div style="font-size: 11px; color: #aaa; margin-top: 3px;">
                    Quantity: <span style="color: #fff; font-weight: bold;">${item.quantity}</span>
                </div>
            </div>
            <div style="text-align: right;">
                <div style="color: #ffd700; font-weight: bold;">${window.getCoinIconHTML ? window.getCoinIconHTML(14) : '🪙'} ${sellPrice}</div>
            </div>
        `;

        btn.onclick = () => {
            if (basePrice > 0) {
                document.body.removeChild(overlay);
                if (playerNum === 2) window.p2ActiveModal = prevActiveModal;
                else window.p1ActiveModal = prevActiveModal;
                if (window.updateModalVisibility) window.updateModalVisibility();
                callback(index, basePrice, item.name);
            } else {
                window.showModernNotification("❌ This item cannot be sold.");
            }
        };

        dialog.appendChild(btn);
    });

    const cancelBtn = document.createElement('button');
    cancelBtn.innerText = "Cancel";
    cancelBtn.style.marginTop = '15px';
    cancelBtn.style.padding = '8px 16px';
    cancelBtn.style.background = '#e53935';
    cancelBtn.style.border = 'none';
    cancelBtn.style.borderRadius = '6px';
    cancelBtn.style.color = 'white';
    cancelBtn.style.cursor = 'pointer';
    cancelBtn.style.width = '100%';
    cancelBtn.style.fontWeight = 'bold';
    cancelBtn.onclick = () => {
        document.body.removeChild(overlay);
        if (playerNum === 2) window.p2ActiveModal = prevActiveModal;
        else window.p1ActiveModal = prevActiveModal;
        if (window.updateModalVisibility) window.updateModalVisibility();
    };
    dialog.appendChild(cancelBtn);

    overlay.appendChild(dialog);
    document.body.appendChild(overlay);
};

