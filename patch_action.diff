window.useBattleItemAction = function(playerNum, itemName) {
    const inv = playerNum === 2 ? window.p2Inventory : window.p1Inventory;
    const itemIdx = inv.findIndex(i => i.name === itemName && i.quantity > 0);
    if (itemIdx === -1) return;

    inv[itemIdx].quantity--;
    if (inv[itemIdx].quantity <= 0) inv.splice(itemIdx, 1);

    if (playerNum === 2) {
        localStorage.setItem('wildpulse_inventory2', JSON.stringify(inv));
        if (window.updateInventoryUI) window.updateInventoryUI();
    } else {
        localStorage.setItem('wildpulse_inventory', JSON.stringify(inv));
        if (window.updateInventoryUI) window.updateInventoryUI();
    }

    const actorName = playerNum === 2 ? window.getP2Name() : window.getP1Name();
    const actorCombatant = playerNum === 2 ? window.currentEnemy : window.currentPlayer;
    const targetCombatant = playerNum === 2 ? window.currentPlayer : window.currentEnemy;

    if (!actorCombatant.battleStats) actorCombatant.battleStats = {};
    if (!targetCombatant.battleStats) targetCombatant.battleStats = {};

    window.logBattle(`<span style="color:#ab47bc; font-weight:bold;">${actorName} used a ${itemName}!</span>`);

    if (itemName === "Stun Grenade") {
        targetCombatant.battleStats.skipTurn = true;
        window.logBattle(`<span style="color:#ffd700;">${targetCombatant.nickname || targetCombatant.name} was stunned and will skip their next turn!</span>`);
    } else if (itemName === "Smoke Bomb") {
        targetCombatant.battleStats.accuracyDecrease = true;
        window.logBattle(`<span style="color:#cccccc;">${targetCombatant.nickname || targetCombatant.name}'s accuracy was severely reduced!</span>`);
    } else if (itemName === "Adrenaline Shot") {
        actorCombatant.battleStats.adrenalineTurns = 3;
        window.logBattle(`<span style="color:#ff0033;">${actorCombatant.nickname || actorCombatant.name} is pumped with Adrenaline! Attacks will deal more damage!</span>`);
    }
};
