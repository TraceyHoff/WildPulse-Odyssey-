  "Crystal Bonsai": "<!-- Intricate cyber pot -->\n                <path d=\"M30,85 L70,85 L75,65 L25,65 Z\" fill=\"#111\" stroke=\"#00ffd2\" stroke-width=\"2\"/>\n                <rect x=\"22\" y=\"60\" width=\"56\" height=\"5\" fill=\"#00ffd2\"/>\n                <line x1=\"40\" y1=\"65\" x2=\"40\" y2=\"85\" stroke=\"#00ffd2\" stroke-width=\"1.5\" stroke-dasharray=\"2 2\"/>\n                <line x1=\"60\" y1=\"65\" x2=\"60\" y2=\"85\" stroke=\"#00ffd2\" stroke-width=\"1.5\" stroke-dasharray=\"2 2\"/>\n                <!-- Trunk -->\n                <path d=\"M50,60 Q40,40 55,30 Q45,20 50,15\" fill=\"none\" stroke=\"#663300\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n                <!-- Crystal leaves/branches -->\n                <polygon points=\"50,15 45,25 55,25\" fill=\"#00ffff\" opacity=\"0.8\"/>\n                <polygon points=\"55,30 65,25 60,35\" fill=\"#00ffff\" opacity=\"0.8\"/>\n                <polygon points=\"45,40 35,35 40,45\" fill=\"#00ffff\" opacity=\"0.8\"/>\n                <circle cx=\"50\" cy=\"15\" r=\"3\" fill=\"#fff\" filter=\"url(#glow)\"/>\n                <circle cx=\"65\" cy=\"25\" r=\"2\" fill=\"#fff\" filter=\"url(#glow)\"/>\n                <circle cx=\"35\" cy=\"35\" r=\"2\" fill=\"#fff\" filter=\"url(#glow)\"/>\n\n                <span style=\"position: absolute; left: -9999px; opacity: 0.001; font-size: 1px; pointer-events: none;\">${emojiMap[\"Crystal Bonsai\"]}</span>",
  "Neon Fern": "<!-- Sleek minimal pot -->\n                <path d=\"M35,85 L65,85 L65,65 L35,65 Z\" fill=\"#222\" stroke=\"#00ff66\" stroke-width=\"2\"/>\n                <rect x=\"30\" y=\"65\" width=\"40\" height=\"4\" fill=\"#00ff66\"/>\n                <!-- Fern fronds -->\n                <path d=\"M50,65 Q30,40 25,25\" fill=\"none\" stroke=\"#00ff66\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n                <path d=\"M50,65 Q70,40 75,25\" fill=\"none\" stroke=\"#00ff66\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n                <path d=\"M50,65 Q50,30 50,15\" fill=\"none\" stroke=\"#00ff66\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n                <path d=\"M50,65 Q40,50 35,40\" fill=\"none\" stroke=\"#00ff66\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                <path d=\"M50,65 Q60,50 65,40\" fill=\"none\" stroke=\"#00ff66\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n                <!-- Glowing spores -->\n                <circle cx=\"25\" cy=\"25\" r=\"2\" fill=\"#fff\" filter=\"url(#glow)\"/>\n                <circle cx=\"75\" cy=\"25\" r=\"2\" fill=\"#fff\" filter=\"url(#glow)\"/>\n                <circle cx=\"50\" cy=\"15\" r=\"3\" fill=\"#fff\" filter=\"url(#glow)\"/>\n\n                <span style=\"position: absolute; left: -9999px; opacity: 0.001; font-size: 1px; pointer-events: none;\">${emojiMap[\"Neon Fern\"]}</span>",
  "Plasma Cactus": "<!-- Hexagonal tech pot -->\n                <polygon points=\"35,85 65,85 75,65 25,65\" fill=\"#333\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <line x1=\"35\" y1=\"85\" x2=\"25\" y2=\"65\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <line x1=\"65\" y1=\"85\" x2=\"75\" y2=\"65\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <!-- Cactus body (glass/plasma container) -->\n                <rect x=\"42\" y=\"30\" width=\"16\" height=\"35\" rx=\"8\" fill=\"rgba(255, 0, 127, 0.3)\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <rect x=\"25\" y=\"40\" width=\"12\" height=\"15\" rx=\"6\" fill=\"rgba(255, 0, 127, 0.3)\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <rect x=\"63\" y=\"35\" width=\"12\" height=\"20\" rx=\"6\" fill=\"rgba(255, 0, 127, 0.3)\" stroke=\"#ff007f\" stroke-width=\"2\"/>\n                <!-- Arms connecting -->\n                <path d=\"M37,50 L42,50\" stroke=\"#ff007f\" stroke-width=\"4\"/>\n                <path d=\"M63,45 L58,45\" stroke=\"#ff007f\" stroke-width=\"4\"/>\n                <!-- Plasma core/bubbles -->\n                <circle cx=\"50\" cy=\"55\" r=\"4\" fill=\"#ff007f\" filter=\"url(#glow)\"/>\n                <circle cx=\"50\" cy=\"40\" r=\"3\" fill=\"#ff007f\" filter=\"url(#glow)\"/>\n                <circle cx=\"31\" cy=\"47\" r=\"2\" fill=\"#ff007f\" filter=\"url(#glow)\"/>\n                <circle cx=\"69\" cy=\"45\" r=\"2\" fill=\"#ff007f\" filter=\"url(#glow)\"/>\n\n                <span style=\"position: absolute; left: -9999px; opacity: 0.001; font-size: 1px; pointer-events: none;\">${emojiMap[\"Plasma Cactus\"]}</span>",
  "Holo Orchid": "<!-- Floating base projector -->\n                <ellipse cx=\"50\" cy=\"75\" rx=\"20\" ry=\"8\" fill=\"#111\" stroke=\"#00ffd2\" stroke-width=\"2\"/>\n                <ellipse cx=\"50\" cy=\"72\" rx=\"15\" ry=\"5\" fill=\"#00ffd2\" opacity=\"0.5\"/>\n                <!-- Holographic projection beam -->\n                <polygon points=\"35,72 65,72 55,20 45,20\" fill=\"rgba(0, 255, 210, 0.15)\"/>\n                <!-- Stem -->\n                <path d=\"M50,70 Q45,50 55,35 Q60,25 50,20\" fill=\"none\" stroke=\"rgba(0, 255, 210, 0.6)\" stroke-width=\"2\" stroke-dasharray=\"2 2\"/>\n                <!-- Petals (Holographic pink/magenta) -->\n                <ellipse cx=\"50\" cy=\"20\" rx=\"10\" ry=\"15\" fill=\"rgba(255, 0, 255, 0.7)\" transform=\"rotate(45 50 20)\"/>\n                <ellipse cx=\"50\" cy=\"20\" rx=\"10\" ry=\"15\" fill=\"rgba(255, 0, 255, 0.7)\" transform=\"rotate(-45 50 20)\"/>\n                <circle cx=\"50\" cy=\"20\" r=\"5\" fill=\"#fff\" filter=\"url(#glow)\"/>\n                <!-- Leaf -->\n                <ellipse cx=\"40\" cy=\"55\" rx=\"8\" ry=\"3\" fill=\"rgba(0, 255, 210, 0.6)\" transform=\"rotate(-30 40 55)\"/>\n\n                <span style=\"position: absolute; left: -9999px; opacity: 0.001; font-size: 1px; pointer-events: none;\">${emojiMap[\"Holo Orchid\"]}</span>",
